      "id": "7c73f767-f2ca-4bc7-b32b-80680c4593e5",
      "name": "Valid API Response?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -360,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst config = $('Configuration').first().json;\n\nif (!Array.isArray(response.jobs)) {\n  throw new Error('Validation failed: Remotive response does not contain a jobs array.');\n}\n\nconst maxJobs = Math.min(Math.max(Number(config.maxJobs) || 10, 1), 50);\nconst received = response.jobs.length;\nconst selected = response.jobs.slice(0, maxJobs);\nconst seenIds = new Set();\nconst valid = [];\nlet rejected = 0;\n\nfunction cleanText(value, maxLength = 50000) {\n  if (value === null || value === undefined) return '';\n  return String(value)\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/gi, ' ')\n    .replace(/&amp;/gi, '&')\n    .replace(/&quot;/gi, '\"')\n    .replace(/&#39;/gi, \"'\")\n    .replace(/&lt;/gi, '<')\n    .replace(/&gt;/gi, '>')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, maxLength);\n}\n\nfor (const job of selected) {\n  const remotiveJobId = String(job?.id ?? '').trim();\n  const jobTitle = cleanText(job?.title, 500);\n  const company = cleanText(job?.company_name, 500);\n  const jobUrl = String(job?.url ?? '').trim();\n  const publicationDate = new Date(job?.publication_date ?? '');\n  const validUrl = /^https?:\\/\\/[^\\s]+$/i.test(jobUrl);\n\n  if (!remotiveJobId || !jobTitle || !company || !validUrl || Number.isNaN(publicationDate.getTime()) || seenIds.has(remotiveJobId)) {\n    rejected += 1;\n    continue;\n  }\n\n  seenIds.add(remotiveJobId);\n  valid.push({\n    json: {\n      remotiveJobId,\n      jobTitle,\n      company,\n      location: cleanText(job.candidate_required_location || 'Worldwide', 500),\n      jobType: cleanText(job.job_type, 200),\n      publicationDate: publicationDate.toISOString(),\n      jobUrl,\n      category: cleanText(job.category, 300),\n      salaryText: cleanText(job.salary, 500),\n      source: 'Remotive',\n      importedAt: new Date().toISOString(),\n      importStatus: 'New',\n      description: cleanText(job.description),\n      deduplicationKey: `remotive:${remotiveJobId}`,\n      _batchReceived: received,\n      _batchSelected: selected.length,\n      _batchValid: selected.length - rejected,\n      _batchRejected: rejected,\n      _searchTerm: String(config.searchTerm || '')\n    }\n  });\n}\n\nif (valid.length === 0) {\n  throw new Error(`Validation failed: ${selected.length} job records were inspected and none were valid for import.`);\n}\n\nfor (const item of valid) {\n  item.json._batchValid = valid.length;\n  item.json._batchRejected = rejected;\n}\n\nreturn valid;"
      },
