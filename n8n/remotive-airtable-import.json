    {
      "parameters": {
        "errorMessage": "={{ 'Remotive import stopped: the API request failed or returned an invalid response. Details: ' + ($json.error?.message || $json.message || 'Expected a non-empty jobs array.') + ' Set Configuration.simulateFailure to false before the next normal run.' }}"
      },
      "id": "b254e97c-ae22-48fa-b1b6-d90169d68daa",
      "name": "Stop - Invalid API Response",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        -120,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const results = $input.all().map(item => item.json);\nconst first = results[0] || {};\nconst created = results.filter(item => item.outcome === 'created').length;\nconst skipped = results.filter(item => item.outcome === 'skipped').length;\n\nreturn [{\n  json: {\n    status: 'completed',\n    searchTerm: first._searchTerm || 'developer',\n    apiJobsReceived: first._batchReceived ?? results.length,\n    jobsSelected: first._batchSelected ?? results.length,\n    validJobs: first._batchValid ?? results.length,\n    rejectedJobs: first._batchRejected ?? 0,\n    createdRecords: created,\n    skippedDuplicates: skipped,\n    processedRecords: created + skipped,\n    deduplicationRule: 'Skip when Remotive Job ID already exists',\n    completedAt: new Date().toISOString()\n  }\n}];"
      },
