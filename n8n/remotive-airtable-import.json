      "id": "df2acc15-6787-4f43-b456-2a44459a783a",
      "name": "Fetch Remotive Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -600,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
